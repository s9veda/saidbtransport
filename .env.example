# Local SQLite output file
SQLITE_PATH=export.db
# Used by the `upload` command (requires the Turso CLI)
TURSO_DB_NAME=tbd

# Schema to export; defaults to ORACLE_USER
ORACLE_SCHEMA=tbd

# Oracle connection settings
ORACLE_CONNECT_STRING=tbd
ORACLE_WALLET_DIR=tbd
ORACLE_WALLET_PASSWORD=tbd
ORACLE_USER=tbd
ORACLE_PASSWORD=tbd
TNS_ADMIN=tbd
