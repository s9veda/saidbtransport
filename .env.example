ORACLE_USER=ADMIN
ORACLE_PASSWORD=
# TNS alias from the wallet's tnsnames.ora, e.g. saisongsdb_medium
# (ORACLE_DSN is also accepted)
ORACLE_CONNECT_STRING=
# Unzipped wallet directory (contains tnsnames.ora, ewallet.pem)
ORACLE_WALLET_DIR=/path/to/wallet
ORACLE_WALLET_PASSWORD=
# Schema to export; defaults to ORACLE_USER
ORACLE_SCHEMA=
# Local SQLite output file
SQLITE_PATH=export.db
# Used by the `upload` command (requires the Turso CLI)
TURSO_DB_NAME=
